[Desktop Entry]
Type=Application
Name=HowlStore
GenericName=Software Store
Comment=Install apps, update the system and read Arch and CachyOS news
Exec=howl-store %u
Icon=io.github.laskywolf.HowlStore
Terminal=false
StartupNotify=true
Categories=System;PackageManager;
MimeType=x-scheme-handler/appstream;application/vnd.flatpak.ref;application/vnd.flatpak;
Keywords=software;store;flatpak;pacman;aur;appimage;update;
